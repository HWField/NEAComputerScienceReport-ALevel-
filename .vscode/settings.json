{
  "editor.fontSize": 14,
  "editor.rulers": {},
  "editor.renderLineHighlight": "line",
  "workbench.colorCustomizations": {
    "editor.lineHighlightBorder": "#fff"
  },
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.drawio$",
        "cmd": "drawio -x -e --export -f pdf --crop --no-sandbox --output \"$(dirname '${file}')/$(basename '${file}' .drawio).pdf\" \"${file}\""
      }
    ]
  },
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": ["latexmk"]
    },
    {
      "name": "latexmk (latexmkrc)",
      "tools": ["latexmk_rconly"]
    },
    {
      "name": "latexmk (lualatex)",
      "tools": ["lualatexmk"]
    },
    {
      "name": "latexmk (xelatex)",
      "tools": ["xelatexmk"]
    },

    {
      "name": "pdflatex -> bibtex -> pdflatex * 2",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    },
    {
      "name": "Compile Rnw files",
      "tools": ["rnw2tex", "latexmk"]
    },
    {
      "name": "Compile Jnw files",
      "tools": ["jnw2tex", "latexmk"]
    },
    {
      "name": "Compile Pnw files",
      "tools": ["pnw2tex", "latexmk"]
    },
    {
      "name": "tectonic",
      "tools": ["tectonic"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "args": ["-pdf", "-interaction=nonstopmode", "-synctex=1", "%DOC%"]
    },
    {
      "name": "latexmk_rconly",
      "command": "/Library/TeX/texbin/latexmk",
      "args": ["%DOC%"]
    },
    {
      "name": "lualatexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "args": ["-lualatex", "-interaction=nonstopmode", "-synctex=1", "%DOC%"]
    },
    {
      "name": "xelatexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-xelatex",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-f",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "/Library/TeX/texbin/pdflatex",
      "args": ["-interaction=nonstopmode", "-synctex=1", "%DOC%"]
    },
    {
      "name": "bibtex",
      "command": "/Library/TeX/texbin/bibtex",
      "args": ["%DOCFILE%"]
    },
    {
      "name": "rnw2tex",
      "command": "Rscript",
      "args": ["-e", "knitr::knit('%DOCFILE_EXT%')"]
    },
    {
      "name": "jnw2tex",
      "command": "julia",
      "args": ["-e", "using Weave; weave(\"%DOCFILE_EXT%\", doctype=\"tex\")"]
    },
    {
      "name": "pnw2tex",
      "command": "pweave",
      "args": ["-f", "tex", "%DOCFILE_EXT%"]
    },
    {
      "name": "tectonic",
      "command": "tectonic",
      "args": ["%DOC%"]
    }
  ]
}
